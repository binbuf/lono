# ======================================================================
# Lono configuration
# Copy to .env, or run scripts/install.(ps1|sh) to generate secrets.
# ======================================================================

# Host ports (all bound to 127.0.0.1)
GATEWAY_PORT=4000
LANGFUSE_PORT=3000
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9091

# observe = log everything, modify nothing
# sanitize = mask secrets + pseudonymize PII (default)
# enforce = sanitize + block on prompt injection / URL policy violations
AI_GATEWAY_MODE=sanitize

LONO_ADMIN_KEY=__LONO_ADMIN_KEY__
LONO_PSEUDONYM_SECRET=__PSEUDONYM_SECRET__
LONO_MEDIA_BACKEND=minio
LONO_LOG_LEVEL=INFO

# Container user for the gateway (Linux bind mounts). install.sh sets these
# to your own uid/gid; irrelevant on Docker Desktop for Windows/macOS.
LONO_UID=1000
LONO_GID=1000

# ======================================================================
# Provider API keys (fill in what you use; LiteLLM reads these)
#
# A key may be a literal value, or a mapping from your system environment so
# you never store the secret in this file. Both styles work:
#
#   OPENAI_API_KEY=sk-...                  # literal value in this file
#   OPENAI_API_KEY=${OPENAI_API_KEY:-}     # use the system env var if set
#
# The `${VAR:-}` form maps the system environment variable VAR into the
# container (falling back to empty when unset). Add any OpenAI-compatible
# provider the same way and declare its models in config/litellm.yaml.
# ======================================================================
OPENAI_API_KEY=${OPENAI_API_KEY:-}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY:-}
GEMINI_API_KEY=${GEMINI_API_KEY:-}
DEEPINFRA_API_KEY=${DEEPINFRA_API_KEY:-}
LITHOSAI_API_KEY=${LITHOSAI_API_KEY:-}
MORPH_API_KEY=${MORPH_API_KEY:-}
OPENROUTER_API_KEY=${OPENROUTER_API_KEY:-}
# OLLAMA_API_BASE=http://host.docker.internal:11434

# LiteLLM master key: point existing clients (OpenCode etc.) at the gateway
# with this value as their API key.
LITELLM_MASTER_KEY=__LITELLM_MASTER_KEY__

# ======================================================================
# Langfuse (self-hosted, auto-provisioned on first start)
# ======================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=__NEXTAUTH_SECRET__
SALT=__SALT__
ENCRYPTION_KEY=__ENCRYPTION_KEY__
LANGFUSE_INIT_ORG_ID=lono
LANGFUSE_INIT_ORG_NAME=Lono
LANGFUSE_INIT_PROJECT_ID=lono
LANGFUSE_INIT_PROJECT_NAME=Lono
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=__LANGFUSE_PUBLIC_KEY__
LANGFUSE_INIT_PROJECT_SECRET_KEY=__LANGFUSE_SECRET_KEY__
LANGFUSE_INIT_USER_EMAIL=admin@lono.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=__LANGFUSE_PASSWORD__

# ======================================================================
# Internal datastores (no host ports; change only before first start)
# ======================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=__CLICKHOUSE_PASSWORD__
REDIS_AUTH=__REDIS_AUTH__
MINIO_ROOT_USER=lono
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
MINIO_BUCKET=lono-media